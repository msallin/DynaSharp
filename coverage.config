<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft.Testing.Extensions.CodeCoverage settings: measure the shipped libraries only. -->
<Configuration>
  <Format>cobertura</Format>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[/\\]DynaSharp\.dll$</ModulePath>
        <ModulePath>.*[/\\]DynaSharp\.Coordination\.dll$</ModulePath>
        <ModulePath>.*[/\\]DynaSharp\.Generators\.dll$</ModulePath>
        <ModulePath>.*[/\\]DynaSharp\.Testing\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <IncludeTestAssembly>false</IncludeTestAssembly>
  </CodeCoverage>
</Configuration>
