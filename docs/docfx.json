{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src/DynaSharp.Testing/bin/Release/net11.0",
          "files": ["DynaSharp.dll", "DynaSharp.Testing.dll"]
        },
        {
          "src": "../src/DynaSharp.Coordination/bin/Release/net11.0",
          "files": ["DynaSharp.Coordination.dll"]
        }
      ],
      "dest": "api",
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      { "files": ["**/*.{md,yml}"], "exclude": ["obj/**"] }
    ],
    "resource": [
      { "files": ["images/**"] }
    ],
    "output": "../artifacts/site",
    "template": ["default", "modern"],
    "xref": ["https://learn.microsoft.com/en-us/dotnet/.xrefmap.json"],
    "sitemap": {
      "baseUrl": "https://msallin.github.io/DynaSharp/"
    },
    "globalMetadata": {
      "_appName": "DynaSharp",
      "_appTitle": "DynaSharp",
      "_appLogoPath": "images/logo-nav.svg",
      "_appFaviconPath": "images/logo-nav.svg",
      "_appFooter": "DynaSharp is MIT licensed. <a href=\"https://github.com/msallin/DynaSharp\">Source on GitHub</a>.",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
