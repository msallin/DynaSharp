<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Build-time only, applied to every project. Nothing here ships in the package. -->
  <ItemGroup>
    <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.3.151-beta" />
  </ItemGroup>

  <ItemGroup>
    <!-- src: build-time only -->
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <!-- The Roslyn the source generator compiles against. A floor, not "latest": it only has to be at or below every compiler
         that loads the generator. Held back on purpose, see the ignore entry in .github/dependabot.yml. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <!-- Only for the code fix of the analyzers, which only an IDE loads. Same floor as the compiler package, and never a dependency of the package. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />

    <!-- tests -->
    <PackageVersion Include="TUnit" Version="1.76.45" />
    <!-- Unit tests only: property-based tests. Released with TUnit, so it takes the same version. -->
    <PackageVersion Include="TUnit.FsCheck" Version="1.76.45" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <!-- Integration tests only: starts the emulator containers. -->
    <PackageVersion Include="Testcontainers" Version="4.16.0" />

    <!-- benchmarks: 0.15.x does not recognize the net11.0 runtime -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <!-- benchmarks only: the clients DynaSharp is compared with. Never referenced from src/. -->
    <PackageVersion Include="EfficientDynamoDb" Version="0.9.19" />
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.0.110.2" />
  </ItemGroup>
</Project>
