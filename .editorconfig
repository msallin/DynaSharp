root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,xml,config,slnx,json,yml,yaml}]
indent_size = 2

[*.sh]
end_of_line = lf

[*.verified.*]
end_of_line = lf
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.cs]
# ---------------------------------------------------------------------------
# Formatting
# ---------------------------------------------------------------------------
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# ---------------------------------------------------------------------------
# Code style (enforced in build via EnforceCodeStyleInBuild)
# ---------------------------------------------------------------------------
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

csharp_style_var_for_built_in_types = true:error
csharp_style_var_when_type_is_apparent = true:error
csharp_style_var_elsewhere = true:error

csharp_prefer_braces = true:error
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:error
csharp_style_expression_bodied_constructors = false:error
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_switch_expression = true:error
csharp_style_prefer_pattern_matching = true:error
csharp_style_pattern_matching_over_is_with_cast_check = true:error
csharp_style_inlined_variable_declaration = true:error
csharp_style_throw_expression = true:error
csharp_style_prefer_range_operator = true:error
csharp_style_prefer_index_operator = true:error
csharp_prefer_static_local_function = true:error
csharp_style_unused_value_assignment_preference = discard_variable:error
csharp_style_unused_value_expression_statement_preference = discard_variable:suggestion

dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error
dotnet_style_qualification_for_event = false:error
dotnet_style_predefined_type_for_locals_parameters_members = true:error
dotnet_style_predefined_type_for_member_access = true:error
dotnet_style_require_accessibility_modifiers = always:error
dotnet_style_readonly_field = true:error
dotnet_style_prefer_collection_expression = when_types_loosely_match:error
dotnet_style_object_initializer = true:error
dotnet_style_collection_initializer = true:error
dotnet_style_coalesce_expression = true:error
dotnet_style_null_propagation = true:error
dotnet_style_prefer_auto_properties = true:error
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
dotnet_style_prefer_conditional_expression_over_return = true:suggestion

# IDE0005: unnecessary usings (requires GenerateDocumentationFile, which is on).
dotnet_diagnostic.IDE0005.severity = error
# IDE0055: formatting, so that the build fails on it. SA1518 does the same for a final newline.
dotnet_diagnostic.IDE0055.severity = error
# IDE0058: expression value never used. Too noisy for fluent APIs.
dotnet_diagnostic.IDE0058.severity = none
# IDE0008: explicit type instead of var. Conflicts with the var preference above.
dotnet_diagnostic.IDE0008.severity = none
# IDE0046 / IDE0045: conditional expressions. Readability is a judgement call.
dotnet_diagnostic.IDE0046.severity = suggestion
dotnet_diagnostic.IDE0045.severity = suggestion

# ---------------------------------------------------------------------------
# Naming
# ---------------------------------------------------------------------------
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = error

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_rule.constants_pascal.severity = error

dotnet_naming_symbols.static_readonly.applicable_kinds = field
dotnet_naming_symbols.static_readonly.required_modifiers = static, readonly
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly
dotnet_naming_rule.static_readonly_pascal.style = pascal
dotnet_naming_rule.static_readonly_pascal.severity = error

# ---------------------------------------------------------------------------
# StyleCop: aligned with the conventions above
# ---------------------------------------------------------------------------
# SA1101: prefix local calls with this. We use the opposite convention.
dotnet_diagnostic.SA1101.severity = none
# SA1309: field names must not begin with underscore. We use _camelCase.
dotnet_diagnostic.SA1309.severity = none
# SA1633-SA1641: file headers. No license headers in every file; LICENSE covers the repo.
dotnet_diagnostic.SA1633.severity = none
dotnet_diagnostic.SA1634.severity = none
dotnet_diagnostic.SA1635.severity = none
dotnet_diagnostic.SA1636.severity = none
dotnet_diagnostic.SA1637.severity = none
dotnet_diagnostic.SA1638.severity = none
dotnet_diagnostic.SA1639.severity = none
dotnet_diagnostic.SA1640.severity = none
dotnet_diagnostic.SA1641.severity = none
# SA1200: using placement. Handled by csharp_using_directive_placement.
dotnet_diagnostic.SA1200.severity = none
# SA1413: trailing commas in multi-line initializers. Noise.
dotnet_diagnostic.SA1413.severity = none
# SA1010 / SA1009: false positives with collection expressions.
dotnet_diagnostic.SA1010.severity = none

# ---------------------------------------------------------------------------
# .NET analyzers (AnalysisLevel = latest-all)
# ---------------------------------------------------------------------------
# CA1303: localize literals. This library does not localize exception messages.
dotnet_diagnostic.CA1303.severity = none

# ---------------------------------------------------------------------------
# Library source only
# ---------------------------------------------------------------------------
[src/**.cs]
# CA1032: standard exception constructors. Service exceptions carry error code, status and request id;
# a parameterless or message-only constructor would produce incomplete instances.
dotnet_diagnostic.CA1032.severity = none
# IDE0130: namespace must match folder. Public namespaces are designed for consumers (few, flat),
# folders for maintainers (one per module).
dotnet_diagnostic.IDE0130.severity = none
# CA1720: identifiers containing type names. DynamoDB's own type names (String, Number) are domain terms here.
dotnet_diagnostic.CA1720.severity = none
# RS0026, RS0027: optional parameters on several overloads. The verbs are overloads over what a key is, each with an optional sort key, and generated code and its package ship together.
dotnet_diagnostic.RS0026.severity = none
dotnet_diagnostic.RS0027.severity = none
# CA1815: the structs of the library are handles, keys, results, markers, converters and enumerators: they are read, rendered or passed
# on, and nothing compares them, as with Dictionary<TKey, TValue>.Enumerator. A value that is compared is a record struct, which has equality.
dotnet_diagnostic.CA1815.severity = none

# ---------------------------------------------------------------------------
# The command API
# ---------------------------------------------------------------------------
[src/DynaSharp/{Expressions,Fluent}/**.cs]
# CA1716: And, Or and Not name what they are; nobody writes the types, they are return types.
dotnet_diagnostic.CA1716.severity = none
# CA2225: the implicit conversions exist for the compiler; the named forms are Condition.Of and ToString.
dotnet_diagnostic.CA2225.severity = none
# CA1711: ReturnNew is the DynamoDB concept ALL_NEW, not a second version of something.
dotnet_diagnostic.CA1711.severity = none
# CA2012: a command's awaiter consumes its ValueTask once, which is what the rule protects.
dotnet_diagnostic.CA2012.severity = none

[src/DynaSharp/Serialization/{Converters/*,AttributeValueConverter}.cs]
# CA1000: converters are empty structs that carry static abstract interface implementations. A generic struct type argument
# gives each instantiation its own code, so the static members on generic types are the design.
dotnet_diagnostic.CA1000.severity = none
