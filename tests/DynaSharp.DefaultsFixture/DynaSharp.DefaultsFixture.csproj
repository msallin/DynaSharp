<Project Sdk="Microsoft.NET.Sdk">

  <!-- [assembly: DynamoDbDefaults] holds for a whole project, so entities that show it need a project of their own, which the unit and integration tests reference. -->
  <ItemGroup>
    <ProjectReference Include="../../src/DynaSharp/DynaSharp.csproj" />
    <!-- The generator reaches a project only through the package, so in the repo it is referenced as an analyzer. -->
    <ProjectReference Include="../../src/DynaSharp.Generators/DynaSharp.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
