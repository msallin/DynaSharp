<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Every test has a table of its own, so the entities of this project never share one. -->
    <NoWarn>$(NoWarn);DYNA026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Testcontainers" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pinned emulator images. The test setup reads the FROM line, so Dependabot's updates reach the tests. -->
    <None Include="Backends/*/Dockerfile" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DynaSharp/DynaSharp.csproj" />
    <ProjectReference Include="../../src/DynaSharp.Coordination/DynaSharp.Coordination.csproj" />
    <!-- The fake backend, see Backends/FakeBackend.cs. -->
    <ProjectReference Include="../../src/DynaSharp.Testing/DynaSharp.Testing.csproj" />
    <ProjectReference Include="../DynaSharp.DefaultsFixture/DynaSharp.DefaultsFixture.csproj" />
    <!-- The generator reaches a project only through the package, so in the repo it is referenced as an analyzer. -->
    <ProjectReference Include="../../src/DynaSharp.Generators/DynaSharp.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
