          "status": 200
        },
        {
          "operation": "DeleteItem",
          "request": {
            "TableName": "fake-vectors",
            "Key": {
              "pk": {
                "S": "none"
              }
            },
            "ConditionExpression": "begins_with(s, :n)",
            "ExpressionAttributeValues": {
              ":n": {
                "N": "1"
              }
            }
          },
          "status": 400,
          "code": "ValidationException",
          "message": "Invalid ConditionExpression: Incorrect operand type for operator or function; operator or function: begins_with, operand type: N"
        },
