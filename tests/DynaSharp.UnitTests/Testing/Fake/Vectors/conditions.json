    {
      "name": "constant-of-the-wrong-type",
      "decides": "Open 4: a constant of the wrong type is rejected before the item is read for begins_with, ADD, DELETE, + and list_append, not for <. Every request names an item that does not exist.",
      "steps": [
        {
          "operation": "CreateTable",
          "request": {
            "TableName": "fake-vectors",
            "AttributeDefinitions": [
              {
                "AttributeName": "pk",
                "AttributeType": "S"
