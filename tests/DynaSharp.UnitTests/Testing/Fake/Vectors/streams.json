          },
          "present": {}
        },
        {
          "operation": "ListStreams",
          "request": {
            "ExclusiveStartStreamArn": "arn:aws:dynamodb:us-east-1:000000000000:table/never-existed/stream/2026-01-01T00:00:00.000"
          },
          "status": 200,
          "select": {
            "Streams": []
          },
          "present": {}
        }
      ]
    },
