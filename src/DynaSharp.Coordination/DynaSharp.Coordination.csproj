<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Stryker compiles with Roslyn 5.9, so nothing newer than what it parses. Never preview. -->
    <LangVersion>14.0</LangVersion>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>DynaSharp.Coordination</PackageId>
    <Description>Distributed coordination on DynamoDB for DynaSharp: a lease on a named lock with fencing tokens, after the semantics of the DynamoDB Lock Client, and leader election on top of it.</Description>
    <PackageTags>dynamodb;aws;lock;lease;leader-election;fencing;aot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="../BannedSymbols.txt" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/images/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <InternalsVisibleTo Include="DynaSharp.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DynaSharp/DynaSharp.csproj" />
  </ItemGroup>

</Project>
