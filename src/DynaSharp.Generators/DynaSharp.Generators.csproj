<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ships inside the DynaSharp package under analyzers/dotnet/cs (see DynaSharp.csproj); never packed or referenced on its own. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Stryker compiles with Roslyn 5.9, so nothing newer than what it parses. Never preview. -->
    <LangVersion>12.0</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <RootNamespace>DynaSharp.Generators</RootNamespace>
    <!-- RS1038: the code fix needs Workspaces, which csc does not have. Only an IDE loads that one class, a compiler creates the types marked as
         generator or analyzer and no other, and the package smoke test runs them from the package without the dll. A second assembly in the
         package would be the way out if this ever stops being true. -->
    <NoWarn>$(NoWarn);RS1038</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="../BannedSymbols.txt" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DynaSharp.UnitTests" />
  </ItemGroup>

</Project>
