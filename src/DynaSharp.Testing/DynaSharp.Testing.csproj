<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Stryker compiles with Roslyn 5.9, so nothing newer than what it parses. Never preview. -->
    <LangVersion>14.0</LangVersion>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>DynaSharp.Testing</PackageId>
    <Description>Test support for DynaSharp: an in-memory fake DynamoDB behind an HTTP handler, a stub HTTP handler that records requests and returns canned DynamoDB responses, and a recording handler that shows the traffic of a real client.</Description>
    <PackageTags>dynamodb;aws;testing;fake;stub;aot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="../BannedSymbols.txt" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/images/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <InternalsVisibleTo Include="DynaSharp.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DynaSharp/DynaSharp.csproj" />
  </ItemGroup>

  <!--
    The package reaches internals of DynaSharp (InternalsVisibleTo), which change between versions, so it depends on exactly the version it was
    packed with: [X] in the nuspec instead of the >= X that NuGet writes for a project reference.
  -->
  <Target Name="PinDynaSharpVersion" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(_ProjectReferencesWithVersions.ProjectVersion)]" />
    </ItemGroup>
  </Target>

</Project>
